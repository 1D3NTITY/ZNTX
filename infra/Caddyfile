# zntx — Repo-Kopie des zntx.de-Blocks in /etc/caddy/Caddyfile (Live-Datei ist maßgeblich,
# diese Datei NIE automatisch deployen — nur zum Review/Diff).
# Live seit 2026-07-20: zntx.de → reverse_proxy localhost:3020, verifiziert (200 auf /,
# /impressum, /datenschutz; matrix-chat-Endpunkte unverändert erreichbar).
#
# WICHTIG: Der zntx.de{}-Block wird mit /srv/matrix-chat geteilt (gemeinsame Apex-Domain).
# Die beiden handle /.well-known/matrix/*-Blöcke gehören matrix-chat (siehe dort
# infra/caddy-routes.caddy) — hier nur unverändert übernommen, damit diese Datei den
# vollständigen Live-Block zeigt. NICHT eigenständig editieren; Änderungen an diesen zwei
# Blöcken laufen über /srv/matrix-chat. zntx "besitzt" ausschließlich den finalen
# handle{}-Fallback (reverse_proxy statt 404).
#
# Nutzt die globalen Snippets service_tls / security_headers der gemeinsamen Caddyfile,
# plus einen eigenen csp_zntx-Snippet (unten) für Cloudflare Turnstile im Kontaktformular.

# Eigener CSP-Snippet für zntx — nicht csp_app/csp_ravepuls_web wiederverwenden (deren
# connect-src/script-src sind auf andere Projekte zugeschnitten). challenges.cloudflare.com
# für Turnstile (Kontaktformular-Spam-Schutz), sonst 'self'.
# WICHTIG (Bug 2026-07-22): Turnstile lädt zur Bot-Erkennung Ressourcen von randomisierten
# Subdomains wie brunhild.challenges.cloudflare.com — eine exakte Origin-Angabe ohne
# Wildcard blockt das (CSP matcht Subdomains NICHT automatisch), Widget rendert dann bei
# niemandem sichtbar. Deshalb *.challenges.cloudflare.com in script-src/connect-src/frame-src.
(csp_zntx) {
    header Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline' 'unsafe-eval' https://challenges.cloudflare.com https://*.challenges.cloudflare.com; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; connect-src 'self' https://challenges.cloudflare.com https://*.challenges.cloudflare.com; frame-src https://challenges.cloudflare.com https://*.challenges.cloudflare.com; font-src 'self' data:; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'; worker-src 'self' blob:; media-src 'self' blob:"
}

zntx.de {
    import service_tls
    import security_headers

    # ── Gehört matrix-chat, nicht anfassen (siehe Hinweis oben) ──
    handle /.well-known/matrix/client {
        header Access-Control-Allow-Origin "*"
        header Content-Type "application/json"
        respond `{"m.homeserver":{"base_url":"https://matrix.zntx.de"}}` 200
    }

    handle /.well-known/matrix/server {
        header Content-Type "application/json"
        respond `{"m.server":"matrix.zntx.de:443"}` 200
    }
    # ── Ende matrix-chat-Bereich ──

    handle {
        import csp_zntx
        reverse_proxy localhost:3020
    }
}
