# zntx — Beispiel-Env, dokumentiert alle Keys (siehe infra/docker-compose.yml).
# Echte Werte NIE hier eintragen, NIE committen — nur die echte Env-Datei befüllen.

# Postgres — eigene isolierte Rolle/DB (zntx_app/zntx_db), nie mit anderen Projekten geteilt.
ZNTX_DB_PASSWORD=

# Cloudflare Turnstile (Kontaktformular-Spam-Schutz).
# TURNSTILE_SITE_KEY wird als Next.js-Build-Arg zu NEXT_PUBLIC_TURNSTILE_SITE_KEY —
# ist absichtlich öffentlich (Site-Keys sind clientseitig sichtbar per Design).
# TURNSTILE_SECRET_KEY bleibt server-only, nie ins Frontend-Bundle.
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# SMTP für die Kontaktformular-Benachrichtigungsmail (best-effort — DB-Insert
# ist die primäre Ablage, Mail-Versand darf fehlschlagen ohne die Anfrage zu verlieren).
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
CONTACT_EMAIL_TO=kontakt@zntx.de
