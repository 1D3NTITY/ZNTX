# zntx — .env.example. Alle Keys hier dokumentieren, nie echte Werte committen.
# Echte Werte kommen in .env (gitignored).

# --- Datenbank (gemeinsame Postgres-16-Instanz infra-postgres-1, eigene DB/Rolle) ---
# Eigene Rolle "zntx_app", nur berechtigt auf zntx_db (nicht der Postgres-Superuser).
# Generieren: openssl rand -hex 32
ZNTX_DB_PASSWORD=changeme
DATABASE_URL=postgresql://zntx_app:${ZNTX_DB_PASSWORD}@localhost:5432/zntx_db

# --- Cloudflare Turnstile (Spam-Schutz Kontaktformular) ---
# Site-Key ist öffentlich (client-seitig eingebettet), Secret-Key bleibt serverseitig.
TURNSTILE_SITE_KEY=changeme
TURNSTILE_SECRET_KEY=changeme
